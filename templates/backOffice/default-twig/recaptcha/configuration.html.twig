{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'ReCaptcha module configuration'|trans({}, 'recaptcha.bo.default') }}{% endblock %}

{% block breadcrumb %}
	<nav aria-label="breadcrumb" class="mb-3">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="{{ path('admin.module') }}">{{ 'Modules'|trans }}</a></li>
			<li class="breadcrumb-item active">{{ 'ReCaptcha'|trans({}, 'recaptcha.bo.default') }}</li>
		</ol>
	</nav>
{% endblock %}

{% block body_testid %}recaptcha-configuration{% endblock %}

{% block content %}
    {% if is_granted('VIEW', {resource: 'admin.module', module: 'ReCaptcha'}) %}
    <style>
        .recaptcha_radio {
            cursor: pointer;
        }
    </style>

    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">{{ 'ReCaptcha configuration'|trans({}, 'recaptcha.bo.default') }}</h4>
            </div>
            <div class="card-body">
	            {% form_theme form with bo_form_themes only %}
				{{ form_start(form, {action : path('admin.recaptcha.config.save')}) }}
	            {% if form_error_message is defined and form_error_message %}
		            <div class="alert alert-danger">{{ form_error_message }}</div>
	            {% endif %}
	            <input type="hidden" name="{{ field_name(form.success_url) }}" value="{{ path('admin.recaptcha.config') }}">

				<fieldset>
					<div class="row">
						{{ form_rest(form) }}
					</div>
				</fieldset>
	            <div class="col-md-12 mb-3">
		            <p>{{ 'These infos are available here : '|trans({}, 'recaptcha.bo.default') }}<a href="http://www.google.com/recaptcha/admin">http://www.google.com/recaptcha/admin</a></p>
	            </div>
	            <div class="col-md-12">
		            <button type="submit" class="btn btn-success">{{ 'Save'|trans }}</button>
	            </div>
             	{{ form_end(form) }}
            </div>
        </div>
    </div>
    {% else %}
        <div class="alert alert-danger">{{ 'You are not allowed to perform this action'|trans }}</div>
    {% endif %}
{% endblock %}
